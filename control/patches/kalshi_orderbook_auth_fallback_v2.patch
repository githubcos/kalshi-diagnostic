diff --git a/kalshi/market.go b/kalshi/market.go
--- a/kalshi/market.go
+++ b/kalshi/market.go
@@ -218,6 +218,11 @@ func (c *Client) GetOrderBook(ctx context.Context, tokenID string) (*OrderBook, e
 	path := "/markets/" + url.PathEscape(ticker) + "/orderbook"
 
 	var response orderbookResponse
 	if err := c.DoPublic(ctx, http.MethodGet, path, &response); err != nil {
-		return nil, err
+		if c.PrivateKey == nil || strings.TrimSpace(c.APIKeyID) == "" {
