+++ b/kalshi/market_test.go
@@ -0,0 +1,35 @@
+package kalshi
+
+import "testing"
+
+func TestConvertMarketPrefersExpirationTimeForStrategyWindow(t *testing.T) {
+	m := apiMarket{
+		Ticker:         "KXBTC15M-TEST",
+		EventTicker:    "KXBTC15M",
+		Status:         "open",
+		OpenTime:       "2026-08-26T02:15:00Z",
+		ExpirationTime: "2026-08-26T02:30:00Z",
+		CloseTime:      "2026-08-26T02:45:00Z",
+	}
+
+	got := convertMarket(m)
+	if got.EndDateISO != m.ExpirationTime {
+		t.Fatalf("expected strategy end %q from expiration_time, got %q", m.ExpirationTime, got.EndDateISO)
+	}
+}
+
+func TestConvertMarketFallsBackToCloseTime(t *testing.T) {
+	m := apiMarket{
+		Ticker:      "KXBTC15M-TEST",
+		EventTicker: "KXBTC15M",
+		Status:      "open",
+		OpenTime:    "2026-08-26T02:15:00Z",
+		CloseTime:   "2026-08-26T02:30:00Z",
+	}
+
+	got := convertMarket(m)
+	if got.EndDateISO != m.CloseTime {
+		t.Fatalf("expected fallback strategy end %q from close_time, got %q", m.CloseTime, got.EndDateISO)
+	}
+}
