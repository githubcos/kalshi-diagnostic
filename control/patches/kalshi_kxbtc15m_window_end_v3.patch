+	endDate := m.ExpectedExpirationTime
+	// KXBTC15M's API expiration metadata can point far beyond the 15-minute
+	// trading window. For this recurring series, the observed Kalshi close_time
+	// is one 15-minute interval after the strategy window boundary, so derive the
+	// strategy end from close_time - 15m. This prevents both the old +15m stall
+	// and the multi-day expiration stall while keeping the venue mapping local.
+	if strings.EqualFold(m.EventTicker, "KXBTC15M") && m.CloseTime != "" {
+		if closeAt, err := time.Parse(time.RFC3339, m.CloseTime); err == nil {
+			endDate = closeAt.Add(-15 * time.Minute).Format(time.RFC3339)
+		}
+	}
+	if endDate == "" {
+		endDate = m.CloseTime
+	}
