diff --git a/kalshi/client.go b/kalshi/client.go
--- a/kalshi/client.go
+++ b/kalshi/client.go
@@ -149,3 +149,24 @@ func (c *Client) DoPublic(ctx context.Context, method, path string, out any) erro
 
 	return nil
 }
+
+// DoMarketData preserves the public-first market-data path but retries the
+// same read with Kalshi authentication when credentials are already available.
+// Kalshi has changed authentication requirements on market-data endpoints over
+// time; this keeps PAPER/LIVE market reads compatible without changing trading
+// semantics or credential configuration.
+func (c *Client) DoMarketData(ctx context.Context, method, path string, out any) error {
+	publicErr := c.DoPublic(ctx, method, path, out)
+	if publicErr == nil {
+		return nil
+	}
+
+	if c.PrivateKey == nil || strings.TrimSpace(c.APIKeyID) == "" {
+		return publicErr
+	}
+
+	if authErr := c.Do(ctx, method, path, nil, out); authErr != nil {
+		return fmt.Errorf("kalshi market data public request failed: %v; authenticated retry failed: %w", publicErr, authErr)
+	}
+
+	return nil
+}
