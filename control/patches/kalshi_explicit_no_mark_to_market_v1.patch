+func TestKalshiPairMarkToMarketUsesExplicitNoPrice(t *testing.T) {
+	p := &PairArbPosition{
+		YesShares: 5, NoShares: 3,
+		YesUSDSpent: 2.10, NoUSDSpent: 1.80,
+	}
